<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login & Sign Up | AttenSys</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            background-image:
                radial-gradient(at 0% 0%, rgb(255, 255, 255) 0, transparent 50%),
                radial-gradient(at 50% 0%, rgb(255, 255, 255) 0, transparent 50%),
                radial-gradient(at 100% 0%, rgb(255, 255, 255) 0, transparent 50%);
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        /* Smooth Form Transitions */
        .form-wrapper {
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: absolute;
            width: 100%;
            top: 0;
            left: 0;
            height: 100%;
            padding: 2rem;
            /* Compact padding */
            overflow-y: auto;
            /* Internal scroll if needed */
        }

        /* Hide scrollbar for clean look */
        .form-wrapper::-webkit-scrollbar {
            display: none;
        }

        .form-wrapper {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .form-hidden {
            transform: translateX(120%);
            opacity: 0;
            pointer-events: none;
            visibility: hidden;
        }

        .form-active {
            transform: translateX(0);
            opacity: 1;
            pointer-events: auto;
            visibility: visible;
        }

        /* Role Selector Styles */
        .role-selector {
            background: #f1f5f9;
            border-radius: 9999px;
            padding: 0.25rem;
            position: relative;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
        }

        .role-selector button {
            position: relative;
            z-index: 10;
            transition: all 0.3s ease;
        }

        .role-selector button.active {
            background-color: white;
            color: #4f46e5;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.06);
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-4">

    <div
        class="w-full max-w-[1000px] bg-white/90 backdrop-blur-xl rounded-3xl shadow-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-2 min-h-[600px] relative">

        <div
            class="hidden lg:flex flex-col items-center justify-center bg-gradient-to-br from-indigo-600 to-violet-700 p-8 text-center relative overflow-hidden h-full">
            <div class="absolute top-0 left-0 w-full h-full overflow-hidden opacity-10">
                <div class="absolute -top-24 -left-24 w-64 h-64 rounded-full bg-white mix-blend-overlay blur-3xl"></div>
                <div
                    class="absolute -bottom-24 -right-24 w-80 h-80 rounded-full bg-pink-500 mix-blend-overlay blur-3xl">
                </div>
            </div>

            <div class="relative z-10 w-full max-w-xs">
                <img src="https://illustrations.popsy.co/amber/student-going-to-school.svg" alt="Login Illustration"
                    class="w-full h-auto drop-shadow-2xl mb-6 transform hover:scale-105 transition-transform duration-500">

                <h2 class="text-2xl font-bold text-white mb-2 tracking-tight">Streamline Attendance</h2>
                <p class="text-indigo-100 text-sm leading-relaxed">
                    Experience the future of classroom management. <br>Secure, fast, and automated.
                </p>
            </div>
        </div>

        <div class="relative w-full h-full bg-white">

            <div id="login-form-wrapper" class="form-wrapper form-active flex flex-col justify-center">
                <div class="w-full max-w-sm mx-auto">
                    <div class="text-center mb-4">
                        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Welcome Back</h1>
                        <p class="text-gray-500 text-xs">Please sign in to your account</p>
                    </div>

                    <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mb-4 flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-600 mt-0.5 flex-shrink-0"
                            viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                                clip-rule="evenodd" />
                        </svg>
                        <div class="text-[11px] text-amber-800 text-left leading-tight">
                            <span class="font-bold block mb-0.5">One Browser Policy</span>
                            Use the <strong>same browser</strong> on the <strong>same phone</strong> every time.
                            Switching browsers or using Incognito will block access.
                        </div>
                    </div>

                    <form id="login-form" class="space-y-4">
                        <div class="role-selector grid grid-cols-2 gap-1 mb-4">
                            <button type="button" data-role="student"
                                class="py-2 rounded-full text-xs font-semibold text-gray-500 hover:text-gray-700 active">Student</button>
                            <button type="button" data-role="teacher"
                                class="py-2 rounded-full text-xs font-semibold text-gray-500 hover:text-gray-700">Teacher</button>
                        </div>

                        <div>
                            <label for="login-email" class="block text-xs font-medium text-gray-700 mb-1 ml-1">Email
                                Address</label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-gray-400 group-focus-within:text-indigo-500 transition-colors"
                                        fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                                    </svg>
                                </div>
                                <input type="email" id="login-email" name="email"
                                    class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all duration-200 text-sm"
                                    placeholder="student@college.edu" required>
                            </div>
                        </div>

                        <div>
                            <label for="login-password"
                                class="block text-xs font-medium text-gray-700 mb-1 ml-1">Password</label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-gray-400 group-focus-within:text-indigo-500 transition-colors"
                                        fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                </div>
                                <input type="password" id="login-password" name="password"
                                    class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all duration-200 text-sm"
                                    placeholder="••••••••" required>
                            </div>
                        </div>

                        <div class="flex items-center justify-between mt-1">
                            <div class="flex items-center">
                                <input id="remember-me" name="remember-me" type="checkbox"
                                    class="h-3.5 w-3.5 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded cursor-pointer">
                                <label for="remember-me"
                                    class="ml-2 block text-xs text-gray-600 cursor-pointer">Remember me</label>
                            </div>
                            <a href="#"
                                class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">Forgot
                                password?</a>
                        </div>

                        <div id="login-error-message"
                            class="hidden animate-pulse bg-red-50 border border-red-200 text-red-600 px-3 py-2 rounded-lg flex items-start gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 flex-shrink-0"
                                viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd"
                                    d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                    clip-rule="evenodd" />
                            </svg>
                            <p class="text-xs" id="login-error-text"></p>
                        </div>

                        <button type="submit"
                            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/40 transform hover:-translate-y-0.5 transition-all duration-200 text-sm">Sign
                            In</button>

                        <div class="relative my-6">
                            <div class="absolute inset-0 flex items-center">
                                <div class="w-full border-t border-gray-200"></div>
                            </div>
                            <div class="relative flex justify-center text-xs"><span
                                    class="px-2 bg-white text-gray-500">New here?</span></div>
                        </div>

                        <div class="text-center">
                            <button type="button" id="show-signup"
                                class="text-indigo-600 hover:text-indigo-800 font-semibold transition-colors text-sm">Create
                                an account &rarr;</button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="signup-form-wrapper" class="form-wrapper form-hidden flex flex-col justify-center">
                <div class="w-full max-w-sm mx-auto">
                    <div class="text-center mb-4">
                        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Create Account</h1>
                        <p class="text-gray-500 text-xs">Start your journey with AttenSys</p>
                    </div>

                    <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mb-4 flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-600 mt-0.5 flex-shrink-0"
                            viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                                clip-rule="evenodd" />
                        </svg>
                        <div class="text-[11px] text-amber-800 text-left leading-tight">
                            <span class="font-bold block mb-0.5">Important: Device Linking</span>
                            Your account will be permanently linked to this browser. Do not sign up on a friend's
                            device.
                        </div>
                    </div>

                    <form id="signup-form" class="space-y-4">
                        <div class="role-selector grid grid-cols-2 gap-1 mb-4">
                            <button type="button" data-role="student"
                                class="py-2 rounded-full text-xs font-semibold text-gray-500 hover:text-gray-700 active">Student</button>
                            <button type="button" data-role="teacher"
                                class="py-2 rounded-full text-xs font-semibold text-gray-500 hover:text-gray-700">Teacher</button>
                        </div>

                        <div>
                            <label for="signup-name" class="block text-xs font-medium text-gray-700 mb-1 ml-1">Full
                                Name</label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-gray-400 group-focus-within:text-indigo-500 transition-colors"
                                        fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </div>
                                <input type="text" id="signup-name" name="name"
                                    class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all duration-200 text-sm"
                                    placeholder="John Doe" required>
                            </div>
                        </div>

                        <div>
                            <label for="signup-email" class="block text-xs font-medium text-gray-700 mb-1 ml-1">Email
                                Address</label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-gray-400 group-focus-within:text-indigo-500 transition-colors"
                                        fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <input type="email" id="signup-email" name="email"
                                    class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all duration-200 text-sm"
                                    placeholder="you@example.com" required>
                            </div>
                        </div>

                        <div>
                            <label for="signup-password"
                                class="block text-xs font-medium text-gray-700 mb-1 ml-1">Password</label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 text-gray-400 group-focus-within:text-indigo-500 transition-colors"
                                        fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                </div>
                                <input type="password" id="signup-password" name="password"
                                    class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition-all duration-200 text-sm"
                                    placeholder="Min. 8 characters" required>
                            </div>
                        </div>

                        <button type="submit"
                            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/40 transform hover:-translate-y-0.5 transition-all duration-200 text-sm mt-2">Create
                            Account</button>

                        <div class="relative my-6">
                            <div class="absolute inset-0 flex items-center">
                                <div class="w-full border-t border-gray-200"></div>
                            </div>
                            <div class="relative flex justify-center text-xs"><span
                                    class="px-2 bg-white text-gray-500">Already a member?</span></div>
                        </div>

                        <div class="text-center">
                            <button type="button" id="show-login"
                                class="text-indigo-600 hover:text-indigo-800 font-semibold transition-colors text-sm">Sign
                                in here &rarr;</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <script src="/javascripts/login-signup.js"></script>
</body>

</html>